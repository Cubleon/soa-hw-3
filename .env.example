# Local development defaults. Copy to .env to override.
GRPC_API_KEY=local-dev-service-key
FLIGHT_DB_PASSWORD=flight_local
BOOKING_DB_PASSWORD=booking_local
BOOKING_PORT=8080
FLIGHT_GRPC_PORT=50051
CACHE_TTL=5m
GRPC_ATTEMPT_TIMEOUT=1s
GRPC_RETRY_BACKOFF=100ms
CB_FAILURE_THRESHOLD=5
CB_WINDOW=30s
CB_OPEN_TIMEOUT=10s
